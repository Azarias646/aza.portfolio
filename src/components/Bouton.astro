---
/**
 * Bouton-lien en pilule (§ 3.4). Au survol, le fond se remplit depuis le côté
 * par lequel entre le curseur (script boutons.ts) ; sans JavaScript, il reste un lien normal.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variante?: 'principal' | 'second';
}
const { variante = 'principal', class: classe, ...attributs } = Astro.props;
---

<a class:list={['btn', variante, classe]} {...attributs}>
  <slot />
</a>

<style>
  .btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 24px;
    border-radius: var(--rayon-pilule);
    font-weight: 600;
    transition:
      color 320ms var(--courbe-sortie),
      transform var(--duree-rapide);
  }
  .btn:active {
    transform: scale(0.98);
  }
  /* Remplissage directionnel : --bx vaut -101 % (gauche), 0 (plein) ou 101 % (droite) */
  .btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--balayage);
    transform: translateX(var(--bx, -101%));
    transition: transform 460ms var(--courbe-poussee);
  }
  .btn:global(.sans-transition)::before {
    transition: none;
  }
  .btn:global(.rempli) {
    color: var(--page);
    transition:
      color 160ms linear 200ms,
      transform var(--duree-rapide);
  }
  .principal {
    --balayage: var(--accent-texte);
    background: var(--accent);
    color: var(--sur-accent);
  }
  .second {
    --balayage: var(--texte);
    border: 1px solid var(--texte-discret);
    background: transparent;
    color: var(--texte);
  }
  .btn :global(svg) {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
