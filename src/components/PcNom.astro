---
/**
 * PC de bureau en traits fins autour du nom (§ 3.17) : écran « ~ $ whoami » qui encadre le h1,
 * clavier réaliste et souris dessinés en SVG, tour à droite (masquée sous 1 320 px).
 * Le clavier est calculé ici : chaque touche est placée en unités de touche standard.
 */
import { site } from '../data/site';

// Boîtier du clavier dans le viewBox 0 0 440 98
const boitier = { x: 30, y: 36, largeur: 326, hauteur: 58 };
const marge = 4;
const ecart = 1.3;
const unitesParLigne = 18.6; // 15 unités du bloc principal + 0,6 d'écart + 3 du pavé de navigation
const unite = (boitier.largeur - 2 * marge + ecart) / unitesParLigne;
const nbRangees = 6;
const ecartFonctions = 2.2;
const hauteurTouche = (boitier.hauteur - 2 * marge - ecart * (nbRangees - 1) - ecartFonctions) / nbRangees;
const x0 = boitier.x + marge;

type Touche = { x: number; y: number; largeur: number; classe?: string };
const touches: Touche[] = [];
const ajouter = (u: number, y: number, largeurU: number, classe?: string) =>
  touches.push({ x: x0 + u * unite, y, largeur: largeurU * unite - ecart, ...(classe ? { classe } : {}) });

// Rangée de fonction : Échap, F1–F12 en trois groupes, trois touches système
let y = boitier.y + marge;
ajouter(0, y, 1, 'esc');
for (const debut of [2, 6.5, 11]) for (let i = 0; i < 4; i++) ajouter(debut + i, y, 1);
for (let i = 0; i < 3; i++) ajouter(15.6 + i, y, 1);
const yVoyants = y + hauteurTouche + ecart + ecartFonctions / 2 - 0.6;
y += hauteurTouche + ecart + ecartFonctions;

// Bloc principal (largeurs en unités) et pavé de navigation (colonnes 0 à 2)
const rangees = [
  [...Array<number>(13).fill(1), 2],
  [1.5, ...Array<number>(12).fill(1), 1.5],
  [1.75, ...Array<number>(11).fill(1), 2.25],
  [2.25, ...Array<number>(10).fill(1), 2.75],
  [1.25, 1.25, 1.25, 6.25, 1.25, 1.25, 1.25, 1.25],
];
const navigation: Record<number, number[]> = { 0: [0, 1, 2], 1: [0, 1, 2], 3: [1], 4: [0, 1, 2] };
rangees.forEach((rangee, i) => {
  let u = 0;
  for (const largeur of rangee) {
    ajouter(u, y, largeur, largeur === 6.25 ? 'espace' : undefined);
    u += largeur;
  }
  for (const colonne of navigation[i] ?? []) ajouter(15.6 + colonne, y, 1);
  y += hauteurTouche + ecart;
});
const voyants = [0, 1, 2].map((i) => x0 + (15.6 + i) * unite + unite / 2 - ecart / 2);
const f = (n: number) => n.toFixed(1);
---

<div class="pc">
  <div class="ecran-nom">
    <p class="invite" aria-hidden="true">
      <span>~</span> $ whoami
    </p>
    <h1>
      <span class="ligne-nom">{site.prenom}</span>
      <span class="ligne-nom">
        {site.nom.replace(`${site.prenom} `, '')}
        <i class="curseur" aria-hidden="true"></i>
      </span>
    </h1>
  </div>
  <svg class="bureau" viewBox="0 0 440 98" aria-hidden="true" focusable="false">
    <path d="M202 0 L196 24 H244 L238 0"></path>
    <path d="M172 27 H268"></path>
    <rect
      class="boitier"
      x={boitier.x}
      y={boitier.y}
      width={boitier.largeur}
      height={boitier.hauteur}
      rx="5"
    ></rect>
    {touches.map((t) => (
      <g class:list={['touche', t.classe]}>
        <rect class="cote" x={f(t.x)} y={f(t.y)} width={f(t.largeur)} height={f(hauteurTouche)} rx="1.4" />
        <rect
          class="dessus"
          x={f(t.x + 1)}
          y={f(t.y + 0.6)}
          width={f(t.largeur - 2)}
          height={f(hauteurTouche - 2.4)}
          rx="1"
        />
      </g>
    ))}
    {voyants.map((cx, i) => (
      <circle class:list={['voyant', { allume: i === 0 }]} cx={f(cx)} cy={f(yVoyants)} r="0.9" />
    ))}
    <path
      class="boitier"
      d="M366 58 Q366 48 378 48 Q390 48 390 58 V80 Q390 94 378 94 Q366 94 366 80 Z"
    ></path>
    <path d="M366 64 H390 M378 48 V64"></path>
    <rect class="molette" x="376" y="52" width="4" height="8" rx="2"></rect>
    <path class="cable" d="M378 48 Q378 36 364 31 Q330 22 290 22"></path>
  </svg>
  <div class="tour" aria-hidden="true">
    <i class="baie"></i>
    <i class="baie"></i>
    <i class="grille-air"></i>
  </div>
</div>

<style>
  .pc {
    position: relative;
    display: inline-block;
    max-width: 100%;
    margin: 22px 0 124px;
  }
  .ecran-nom {
    padding: 18px clamp(18px, 2.4vw, 30px) clamp(16px, 2vw, 26px);
    border: 1.5px solid var(--trait-pc);
    border-radius: 24px;
    background:
      repeating-linear-gradient(180deg, var(--balayage-pc) 0 1px, transparent 1px 4px),
      radial-gradient(
        120% 90% at 30% 20%,
        color-mix(in srgb, var(--accent-trait) 9%, transparent),
        transparent 70%
      );
    transition: border-color 1200ms var(--courbe-sortie);
  }
  .invite {
    padding-left: 2px;
    color: var(--texte-discret);
    font: 500 clamp(12px, 1.1vw, 14px) / 1 var(--police-terminal);
    letter-spacing: 0.02em;
  }
  .invite span {
    color: var(--accent-trait);
  }
  h1 {
    margin-top: 6px;
    font-size: clamp(52px, 9.5vw, 118px);
    line-height: 0.92;
    font-weight: 700;
    font-variation-settings: 'wdth' 125;
    letter-spacing: -0.045em;
  }
  /* Le nom apparaît ligne par ligne, à l'ouverture et à chaque retour sur l'accueil */
  .ligne-nom {
    display: block;
    transition:
      opacity 1100ms var(--courbe-fondu) 150ms,
      transform 1300ms var(--courbe-sortie) 150ms;
    animation: nom-fondu 1300ms var(--courbe-sortie) 200ms backwards;
  }
  .ligne-nom + .ligne-nom {
    transition-delay: 300ms;
    animation-delay: 360ms;
  }
  @keyframes nom-fondu {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  .curseur {
    display: inline-block;
    width: 0.09em;
    height: 0.74em;
    margin-left: 0.06em;
    vertical-align: -0.02em;
    border-radius: 2px;
    background: var(--accent-trait);
    animation: clignote 1.05s steps(1) infinite;
  }
  @keyframes clignote {
    50% {
      opacity: 0;
    }
  }

  .bureau {
    position: absolute;
    left: 50%;
    top: 100%;
    width: min(440px, 92%);
    translate: -50% 0;
    overflow: visible;
    fill: none;
    stroke: var(--trait-pc);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .boitier {
    fill: var(--bord-pc);
  }
  .touche {
    stroke: none;
  }
  .cote {
    fill: var(--touche-cote);
    stroke: var(--filet-pc);
    stroke-width: 0.8;
  }
  .dessus {
    fill: var(--touche-dessus);
  }
  .esc .dessus {
    fill: color-mix(in srgb, var(--accent-trait) 30%, var(--touche-dessus));
  }
  .voyant {
    stroke: none;
    fill: var(--filet-pc);
  }
  .voyant.allume {
    fill: var(--accent-trait);
    opacity: 0.8;
  }
  .molette {
    stroke: none;
    fill: var(--accent-trait);
    opacity: 0.55;
  }
  .cable {
    stroke: var(--filet-pc);
    stroke-width: 1.2;
  }

  /* Tour : à droite de l'écran, posée au niveau du clavier */
  .tour {
    position: absolute;
    left: calc(100% + 20px);
    top: 26px;
    bottom: -86px;
    width: 66px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 16px 10px;
    border: 1.5px solid var(--trait-pc);
    border-radius: 12px;
  }
  .baie {
    width: 100%;
    height: 8px;
    border: 1.5px solid var(--filet-pc);
    border-radius: 3px;
  }
  .grille-air {
    width: 70%;
    height: 38%;
    margin-top: auto;
    background: radial-gradient(circle, var(--points-pc) 1.2px, transparent 1.6px) 0 0 / 7px 7px;
  }

  .invite,
  .bureau,
  .tour {
    transition: opacity 900ms var(--courbe-sortie) 500ms;
  }
  :global(.anime .attente) .ecran-nom {
    border-color: transparent;
  }
  :global(.anime .attente) :is(.invite, .bureau, .tour) {
    opacity: 0;
  }
  :global(.anime .attente) .ligne-nom {
    opacity: 0;
    transform: translateY(14px);
  }

  @media (max-width: 1320px) {
    .tour {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .pc {
      margin-bottom: 88px;
    }
  }
</style>
